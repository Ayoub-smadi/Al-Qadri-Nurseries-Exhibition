# ========================================
# انسخ هذا الملف باسم .env وعدّل القيم
# ========================================

# رابط قاعدة البيانات من Neon أو PostgreSQL
# احصل عليه من: https://console.neon.tech → مشروعك → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# البورت الخاص بالخادم (لا تغيّره)
PORT=8080

# كلمة سر لإعداد حساب الأدمن أول مرة (اختر كلمة سر قوية)
ADMIN_SETUP_SECRET=your_secret_here
