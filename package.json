{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/nursery-showcase run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "deploy": "bash push.sh"
  },
  "private": true,
  "engines": {
    "node": ">=22.x"
  },
  "dependencies": {
    "@vercel/blob": "2.3.1",
    "cors": "^2",
    "express": "^5",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.18.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
